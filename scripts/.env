# Source this file for testing the installer with preset defaults:
#   source scripts/.env && ./scripts/install-usage-reports.sh
#   (or from scripts/: source .env && ./install-usage-reports.sh)
#
# Installer menu: 1=Cloud Shell, 2=Localhost, 3=Quit (empty = prompt each run)
INSTALLER_CHOICE=
# Compartment name for the Functions application (empty = prompt each run)
COMPARTMENT_NAME=
# OCI Functions application name
APP_NAME=oci-usage-reports-app
# Architecture for prebuilt images: x86 or arm (empty = prompt each run)
ARCH=
# OCIR repository name for pushed images
OCIR_REPO_NAME=oci-usage-reports
# Target bucket_name for copyusagereport function
BUCKET_NAME=copyusagereport
# VCN name (when creating new VCN)
VCN_NAME=oci-usage-reports
# Private subnet name (when creating new VCN)
SUBNET_NAME=oci-usage-reports-private
# VCN CIDR block (when creating new VCN)
VCN_CIDR=10.0.0.0/16
# Private subnet CIDR block (when creating new VCN)
SUBNET_CIDR=10.0.1.0/24
# PAR validity in days when creating a new PAR (default 1 year)
PAR_TTL_DAYS=365
# OCIR username (user part only) for Cloud Shell auth token login
OCIR_USER=
# Dynamic group name for IAM policies
DYN_GROUP_NAME=oci-usage-reports-dyn-group
# Script version (auto-updated on commit)
VERSION=2026-02-11_13:45:22
